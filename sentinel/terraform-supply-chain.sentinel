import "tfconfig/v2" as tfconfig

param allowed_provider_sources
param allowed_module_sources

providers_valid = rule {
	length(tfconfig.providers) > 0 and
	all tfconfig.providers as _, provider {
		provider.full_name in allowed_provider_sources and
			(provider.version_constraint else "") is not ""
	}
}

module_calls = tfconfig.module_calls else {}

modules_valid = rule {
	all module_calls as _, module {
		module.source in allowed_module_sources and
			(module.version_constraint else "") is not ""
	}
}

main = rule {
	providers_valid and modules_valid
}
