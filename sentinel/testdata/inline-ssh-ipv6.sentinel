resource_changes = {
	"aws_security_group.web": {
		"mode": "managed",
		"type": "aws_security_group",
		"change": {
			"actions": ["create"],
			"after": {
				"ingress": [
					{
						"protocol":         "tcp",
						"from_port":        22,
						"to_port":          22,
						"ipv6_cidr_blocks": ["::/0"],
					},
				],
			},
		},
	},
}
